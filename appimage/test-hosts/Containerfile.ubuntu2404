# Linux Mint 22.x base (Ubuntu 24.04, glibc 2.39, GTK 4.14): only what the
# tests need, nothing from GTK 4 or GStreamer, so the AppImage must bring
# its own.
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y xvfb xdotool imagemagick python3 dbus dbus-x11 dconf-cli \
        dconf-gsettings-backend libglib2.0-bin weston fontconfig fonts-dejavu-core libx11-6 libxfixes3 adwaita-icon-theme \
        locales && \
    sed -i 's/^# *de_DE.UTF-8/de_DE.UTF-8/' /etc/locale.gen && locale-gen && \
    rm -rf /var/lib/apt/lists/*
