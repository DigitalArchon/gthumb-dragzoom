<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="GthImagesPreferences">
    <property name="title" translatable="yes">Images</property>
    <property name="tag">images</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwComboRow" id="scroll_action">
                    <property name="title" translatable="yes">Scroll Action</property>
                    <signal name="notify::selected" handler="on_scroll_action_selected"/>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Change Zoom</item>
                          <item translatable="yes">Change File</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="AdwComboRow" id="drag_action">
                    <property name="title" translatable="yes">Drag Action</property>
                    <property name="subtitle" translatable="yes">Ctrl+drag always drags the file</property>
                    <signal name="notify::selected" handler="on_drag_action_selected"/>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item translatable="yes">Drag the File</item>
                          <item translatable="yes">Zoom to Selection</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
